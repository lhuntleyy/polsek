# ============================================================
# SIGAP — contoh konfigurasi.
# Salin ke .env untuk pengembangan: cp .env.example .env
# JANGAN commit .env. Ganti semua secret sebelum produksi.
# ============================================================

SIGAP_ENV=development
SIGAP_LOG_LEVEL=info
SIGAP_API_HOST=127.0.0.1
SIGAP_API_PORT=4000
SIGAP_PUBLIC_ORIGIN=http://localhost:5173

# --- Database & media ---
SIGAP_DB_PATH=./data/sigap.db
SIGAP_MEDIA_DIR=./data/media

# --- Identitas unit (bisa juga diubah di menu Pengaturan) ---
SIGAP_UNIT_CODE=BKS
SIGAP_UNIT_NAME="Polsek Contoh"
SIGAP_UNIT_ADDRESS="Jl. Contoh No. 1"
SIGAP_UNIT_TIMEZONE=Asia/Jakarta

# --- WhatsApp (diisi saat Fase 2) ---
# Boleh dikosongkan; diisi otomatis setelah pairing dari dashboard.
SIGAP_WA_NUMBER=
SIGAP_WA_OWNER=
# Boleh angka ID grup saja (120363...); API menambahkan @g.us otomatis.
SIGAP_WA_GROUP_URC_JID=

# --- Internal bot <-> API ---
SIGAP_API_URL=http://127.0.0.1:4000
# Ganti di produksi (min. 32 karakter). Dipakai bot untuk memanggil /internal/*.
# Di produksi bot memakai env sendiri: lihat infra/bot.env.example.
SIGAP_INTERNAL_TOKEN="dev-internal-token-change-me"
SIGAP_BOT_AUTH_DIR=./data/baileys

# --- Web Push (opsional). Buat dengan: node -e "console.log(require('web-push').generateVAPIDKeys())"
SIGAP_VAPID_PUBLIC_KEY=
SIGAP_VAPID_PRIVATE_KEY=
SIGAP_VAPID_SUBJECT="mailto:admin@example.local"

# --- Data protection ---
SIGAP_DPO_NAME="Project Owner"
SIGAP_RETENTION_DAYS=365

# --- SLA & eskalasi (detik) ---
SIGAP_SLA_P1_ACK_SECONDS=120
SIGAP_SLA_P1_OTW_SECONDS=300
SIGAP_ESCALATION_PAWAS_SECONDS=180
SIGAP_ESCALATION_KAPOLSEK_SECONDS=600

# --- Auth ---
# Ganti di produksi. Minimal 32 karakter.
SIGAP_SESSION_SECRET="dev-only-session-secret-change-me-32-chars"
SIGAP_SESSION_TTL_HOURS=12
SIGAP_COOKIE_SECURE=false
SIGAP_COOKIE_NAME=sigap_session

# Admin awal (dibuat saat seed pertama).
SIGAP_ADMIN_USERNAME=admin
SIGAP_ADMIN_PASSWORD="Admin#12345"
SIGAP_ADMIN_NAME="Admin SIGAP"
SIGAP_ADMIN_TOTP_SECRET=

# --- Enkripsi nomor telepon ---
# 32 byte base64. Ganti di produksi. Contoh di bawah hanya untuk dev.
SIGAP_PHONE_KEY="BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc="
SIGAP_PHONE_PEPPER="dev-only-phone-pepper-change-me"

# --- Demo seed ---
# true: isi unit, wilayah demo, petugas, dan tiket contoh.
# false: hanya admin + settings.
SIGAP_SEED_DEMO=true
