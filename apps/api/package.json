{
  "name": "@sigap/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:seed": "tsx src/cli/seed.ts",
    "secrets:rotate": "tsx src/cli/rotate-secrets.ts",
    "regions:import": "tsx src/cli/import-regions.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsup && node scripts/copy-migrations.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^10.2.2",
    "@node-rs/argon2": "^2.0.2",
    "@sigap/config": "workspace:*",
    "@sigap/core": "workspace:*",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "exifr": "^7.1.3",
    "fastify": "^5.6.1",
    "otplib": "^12.0.1",
    "pdfkit": "^0.20.2",
    "sharp": "^0.35.5",
    "web-push": "^4.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "pino-pretty": "^13.1.2",
    "qrcode": "^1.5.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
