# ============================================================
# SIGAP — env khusus bot WhatsApp (/etc/sigap/bot.env, chmod 600,
# owner sigap-bot). JANGAN taruh SESSION_SECRET / PHONE_KEY /
# PHONE_PEPPER / ADMIN_PASSWORD di sini: bot tidak membutuhkannya.
# ============================================================
SIGAP_ENV=production
SIGAP_LOG_LEVEL=info
SIGAP_API_URL=http://127.0.0.1:4000
# Harus SAMA PERSIS dengan SIGAP_INTERNAL_TOKEN di /etc/sigap/api.env (min. 32 karakter).
SIGAP_INTERNAL_TOKEN=
SIGAP_BOT_AUTH_DIR=/var/lib/sigap-bot/baileys
SIGAP_UNIT_NAME="Polsek Contoh"
SIGAP_WA_NUMBER=
