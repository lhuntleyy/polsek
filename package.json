{
  "name": "sigap",
  "version": "1.2.0",
  "private": true,
  "description": "SIGAP — WhatsApp reporting + piket dashboard for Polsek",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @sigap/api --filter @sigap/web --filter @sigap/bot dev",
    "dev:api": "pnpm --filter @sigap/api dev",
    "dev:web": "pnpm --filter @sigap/web dev",
    "dev:bot": "pnpm --filter @sigap/bot dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @sigap/api db:migrate",
    "db:seed": "pnpm --filter @sigap/api db:seed",
    "release": "node scripts/make-release.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "uuid": "^11.1.1"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
